{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/user/:username/",
      "destination": "/user/index.html"
    },
    {
      "source": "/user/:username",
      "destination": "/user/index.html"
    },
    {
      "source": "/recap/:month(month[1-9][0-9]*)/",
      "destination": "/recap/index.html"
    },
    {
      "source": "/recap/:month(month[1-9][0-9]*)",
      "destination": "/recap/index.html"
    }
  ]
}
